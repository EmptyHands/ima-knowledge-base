# ============================================
# 智能知识库问答系统 配置模板
# 复制为 .env 并填写实际值
# ============================================

# --- LLM 配置 (OpenAI 兼容接口, DeepSeek/GLM/OpenAI 均可) ---
LLM_PROVIDER=openai
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4000

# --- Embedding 模型 (DeepSeek 无 embedding 接口, 用本地 Ollama) ---
# provider: ollama / local / openai
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_DEVICE=cpu

# --- Qdrant 向量数据库 ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# --- 数据库 (SQLite 默认, 可切 PostgreSQL: postgresql://user:pass@host/db) ---
DATABASE_URL=sqlite:///./data/ima_kb.db

# --- 认证 ---
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRE_DAYS=7

# --- 文件存储 (本地磁盘, 将来可切 S3 兼容) ---
STORAGE_DIR=./data/uploads

# --- 应用配置 ---
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# --- 检索参数 ---
# 向量检索返回条数
RETRIEVAL_TOP_K=5
# 分块大小(字符) / 重叠
CHUNK_SIZE=800
CHUNK_OVERLAP=100
