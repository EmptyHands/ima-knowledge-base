# ============================================
# 智能知识库问答系统 配置模板
# 复制为 .env 并填写实际值
# ============================================

# --- LLM 配置 (OpenAI 兼容接口, DeepSeek/GLM/OpenAI 均可) ---
LLM_PROVIDER=openai
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4000

# --- Embedding 模型 (DeepSeek 无 embedding 接口, 用本地 Ollama) ---
# provider: ollama / local / openai
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_DEVICE=cpu

# --- Qdrant 向量数据库 ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# --- 数据库 (SQLite 默认, 可切 PostgreSQL: postgresql://user:pass@host/db) ---
DATABASE_URL=sqlite:///./data/ima_kb.db

# --- 认证 ---
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRE_DAYS=7

# --- 文件存储 (本地磁盘, 将来可切 S3 兼容) ---
STORAGE_DIR=./data/uploads

# --- 应用配置 ---
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# --- 检索参数 ---
# 向量检索返回条数 (片段多时建议 8, 避免相关内容被挤出 top-k)
RETRIEVAL_TOP_K=8
# 语义检索最高分低于该值时视为未命中, 触发关键词(BM25)检索兜底
RETRIEVAL_DENSE_THRESHOLD=0.35
# 分块大小(字符) / 重叠
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Redis (DEV-019: langgraph checkpointer 暂存, 未启动自动降级内存) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- 详细日志 (DEV-022: 调试用, 记录内部思考/工具调用/链路/state/RAG查询/chunk结果) ---
# 开启后每次问答追加写入单文件 detail.log; 关闭时零开销
DETAIL_LOG_ENABLED=false
DETAIL_LOG_PATH=./data/logs/detail.log

# --- 网络搜索 (可选, 问题含"最新/实时/网络"等意图时触发 Tavily 搜索) ---
# 不填则关闭网络搜索, 只做知识库内检索
TAVILY_API_KEY=

# --- MCP 工具服务器 (可选, 未配置则 MCP 端点禁用) ---
# 外部 MCP 客户端(如 MCP Inspector)连接 /mcp/sse 的共享密钥
MCP_API_KEY=
